p","title":"Colliders"},{"type":"backdrop","title":"MPM Solver settings"},{"type":"backdrop","title":"MPM Sand"},{"type":"backdrop","title":"Assign Materials"},{"type":"backdrop","title":"Double-click for more info"},{"type":"backdrop","title":"Adjust Plane Height"}]},"ports":[{"portName":"plane_mesh","portDirection":"output","portType":"Object"},{"portName":"out_geometry","portDirection":"output","portType":"array<Object>"}],"terminal_states":[{"name":"Core::Graph::terminal::final","enabled":"false"},{"name":"Core::Graph::terminal::proxy","enabled":"false"},{"name":"Core::Graph::terminal::diagnostic","enabled":"false"}],"node_count":17,"connection_count":18,"value_count":36},{"path":"root/dummy_geo","name":"dummy_geo","metadata":{},"ports":[{"portName":"sphere_mesh","portDirection":"output","portType":"Object"}],"terminal_states":[],"node_count":1,"connection_count":1,"value_count":6},{"path":"root/field_based_cohesion","name":"field_based_cohesion","metadata":{"_notes":[{"type":"sticky_note","text":"# Generate a field\n\nA sphere field generates a scalar (signed distance) field that is positive outside the sphere and negative inside the sphere.\n\nThis field is clamped to the radius of the dummy geo sphere, then divided by that radius, resulting in a field of -1 to 1."},{"type":"sticky_note","text":"By subtracting the field from one, it changes to a 1 to -1 range.\n\nThis results in the sand *cohesion* being 1 at the center of the sphere and smoothly moving to -1 at the edge of the sphere.\n\nThe sphere radius and position is controlled by the ***sphere_field*** compound."}],"_backdrops":[{"type":"backdrop","title":"Sphere field generation"},{"type":"backdrop","title":"Reverse field"}]},"ports":[{"portName":"output","portDirection":"output"}],"terminal_states":[],"node_count":12,"connection_count":13,"value_count":9},{"path":"root/randomize_color","name":"randomize_color","metadata":{},"ports":[{"portName":"granular_particles","portDirection":"input","portType":"Object"},{"portName":"out_geometry","portDirection":"output","portType":"Object"}],"terminal_states":[],"node_count":6,"connection_count":8,"value_count":5},{"path":"root/randomize_color/RGB1","name":"RGB1","metadata":{},"ports":[{"portName":"value","portDirection":"input","portType":"Math::float3","metadata":[{"metaName":"UIWidget","metaType":"string","metaValue":"ColorPicker"}]},{"portName":"color","portDirection":"output"}],"terminal_states":[],"node_count":1,"connection_count":2,"value_count":1}],"teaching_notes":[{"type":"sticky_note","text":"# Dummy Geo\nFeel free to replace this with your own geo."},{"type":"sticky_note","text":"# Vary Source Properties\nThese compounds vary the stated source properties of the MPM simulation.  While this can be animated over time, these are only randomized on creation.\n\nIn this case the *friction* (how much the sand collisions slow each grain down) is varied. "},{"type":"sticky_note","text":"# Collisions\nThese objects are treated by the simulation as colliders.  The friction and bounciness settings for the colliders can be set here."},{"type":"sticky_note","text":"# MPM Sand\nThis is a very basic setup for a simulation of grains of sand.  It simulates a pile of sand collapsing on the ground.  It takes in a mesh to define the initial size, shape and location of the sand-pile, before it collapses.\n\nThe look of the sand is controlled by the varied *friction* property - ***vary_source_property***, the field providing position based *coherence* for the sand, and the *friction* of the plane collider."},{"type":"sticky_note","text":"# Generate a field\n\nA sphere field generates a scalar (signed distance) field that is positive outside the sphere and negative inside the sphere.\n\nThis field is clamped to the radius of the dummy geo sphere, then divided by that radius, resulting in a field of -1 to 1."},{"type":"sticky_note","text":"By subtracting the field from one, it changes to a 1 to -1 range.\n\nThis results in the sand *cohesion* being 1 at the center of the sphere and smoothly moving to -1 at the edge of the sphere.\n\nThe sphere radius and position is controlled by the ***sphere_field*** compound."}]}