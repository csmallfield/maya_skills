th":"root/dummy_geo/assign_gray_shader","name":"standard_surface_mat.coat_rotation","type":"float","value":"0f"},{"path":"root/dummy_geo/assign_gray_shader","name":"standard_surface_mat.sheen","type":"float","value":"0f"},{"path":"root/dummy_geo/assign_gray_shader","name":"standard_surface_mat.sheen_color","type":"Math::float3","value":{"x":"0f","y":"0f","z":"0f"}},{"path":"root/dummy_geo/assign_gray_shader","name":"standard_surface_mat.sheen_roughness","type":"float","value":"0f"},{"path":"root/dummy_geo/assign_gray_shader","name":"standard_surface_mat.emission","type":"float","value":"0f"},{"path":"root/dummy_geo/assign_gray_shader","name":"standard_surface_mat.emission_color","type":"Math::float3","value":{"x":"0f","y":"0f","z":"0f"}}],"compounds":[{"path":"root","name":"Graphs::Aero::dry_ice","metadata":{"compoundIsGraph":"true","author":"Autodesk","category":"Smoke","description":"An aero simulation graph producing a dry ice effect","documentation":"dry_ice_docs_${language}.md","_notes":[{"type":"sticky_note","text":"This simulation is adaptive, you can save simulation time by allowing an automatic coarsening where fog detail is not required"},{"type":"sticky_note","text":"# influences\n\nThis elaborate network of influences gives the smoke many of its key characteristics.  Notable  is the modifier field, which isolates denser clumps of smoke, and  accelerates them,  making them fall quicker, as is observed in reality."},{"type":"sticky_note","text":"The source compound specifies all the initial settings to be fed into the simulation, controlling the emission into the grid."},{"type":"sticky_note","text":"***turbulence_influence*** applies a curl noise to the acceleration of the Aero\n\n***modulate_influence*** scales the connected influence with a simulation property.  In this case the turbulence is scaled by the fog density, giving more turbulent movement where there is more fog."},{"type":"sticky_note","text":"***drag_influence*** simulates the effect of air drag by scaling down the velocity of the Aero each frame.\n\n***modulate_influence*** scales the connected influence with a simulation property.  In this case the vorticity is scaled by the fog density.\n\n***vorticity_influence*** helps the simulation to look more turbulent and more fluid."},{"type":"sticky_note","text":"The ***dissipation influence*** will move a property towards a background value over time.  In this case we are dissipating the *volume_fog_density* value, allowing the \"smoke\" to \"fade out\".\n"}],"_backdrops":[{"type":"backdrop","title":"Influences "},{"type":"backdrop","title":"Double-click for more info"},{"type":"backdrop","title":"Ground Object and collider"},{"type":"backdrop","title":"Assign material"},{"type":"backdrop","title":"Aero simulation"},{"type":"backdrop","title":"Modifier Field"}]},"ports":[{"portName":"cube_mesh","portDirection":"output","portType":"Object"},{"portName":"out_geometry","portDirection":"output","portType":"Object"},{"portName":"out_geometry1","portDirection":"output","portType":"Object"}],"terminal_states":[{"name":"Core::Graph::terminal::final","enabled":"false"},{"name":"Core::Graph::terminal::proxy","enabled":"false"},{"name":"Core::Graph::terminal::diagnostic","enabled":"false"}],"node_count":21,"connection_count":24,"value_count":75},{"path":"root/dummy_geo","name":"dummy_geo","metadata":{"_notes":[{"type":"sticky_note","text":"This is a custom mesh noise used on  source geo to get the  bubbling effect of the dry ice"}],"_backdrops":[{"type":"backdrop","title":"Double-click for more info"}]},"ports":[{"portName":"out_object","portDirection":"output","portType":"Object"}],"terminal_states":[],"node_count":3,"connection_count":3,"value_count":11},{"path":"root/dummy_geo/mesh_noise","name":"mesh_noise","metadata":{"_backdrops":[{"type":"backdrop","title":"Generate Noise Frequency"},{"type":"backdrop","title":"Generate noise speed"},{"type":"backdrop","title":"Scale noise by magnitude"},{"type":"backdrop","title":"Generate Noise"}]},"ports":[{"portName":"geo","portDirection":"input","portType":"Object","metadata":[{"metaName":"pathinfo","metadata":[{"metaName":"path","metaType":"string","metaValue":"/pCube1/pCubeShape1"},{"metaName":"channels","metaType":"string","metaValue":"*"},{"metaName":"setOperation","metaType":"string","metaValue":"+"},{"metaName":"active","metaType":"string","metaValue":"true"},{"metaName":"normalsPerPoint","metaType":"string","metaValue":"true"},{"metaName":"normalsPerFaceVertex","metaType":"string","metaValue":"true"},{"metaName":"normalsPerFace","metaType":"string","metaValue":"false"}]}]},{"portName":"magnitude","portDirection":"input","portType":"float"},{"portName":"frequency","portDirection":"input","portType":"Math::float3"},{"portName":"speed","portDirection":"input","portType":"float"},{"portName":"out_object","portDirection":"output","portType":"Object"},{"portName":"seed","portDirection":"input","portType":"long"}],"terminal_states":[],"node_count":7,"connection_count":13,"value_count":0},{"path":"root/dummy_geo/assign_gray_shader","name":"assign_gray_shader","metadata":{},"ports":[{"portName":"geometry","portDirection":"input","portType":"Object"},{"portName":"out_geometry","portDirection":"output","portType":"Object"}],"terminal_states":[],"node_count":2,"connection_count":3,"value_count":40}],"teaching_notes":[{"type":"sticky_note","text":"This simulation is adaptive, you can save simulation time by allowing an automatic coarsening where fog detail is not required"},{"type":"sticky_note","text":"# influences\n\nThis elaborate network of influences gives the smoke many of its key characteristics.  Notable  is the modifier field, which isolates denser clumps of smoke, and  accelerates them,  making them fall quicker, as is observed in reality."},{"type":"sticky_note","text":"The source compound specifies all the initial settings to be fed into the simulation, controlling the emission into the grid."},{"type":"sticky_note","text":"***turbulence_influence*** applies a curl noise to the acceleration of the Aero\n\n***modulate_influence*** scales the connected influence with a simulation property.  In this case the turbulence is scaled by the fog density, giving more turbulent movement where there is more fog."},{"type":"sticky_note","text":"***drag_influence*** simulates the effect of air drag by scaling down the velocity of the Aero each frame.\n\n***modulate_influence*** scales the connected influence with a simulation property.  In this case the vorticity is scaled by the fog density.\n\n***vorticity_influence*** helps the simulation to look more turbulent and more fluid."},{"type":"sticky_note","text":"The ***dissipation influence*** will move a property towards a background value over time.  In this case we are dissipating the *volume_fog_density* value, allowing the \"smoke\" to \"fade out\".\n"},{"type":"sticky_note","text":"This is a custom mesh noise used on  source geo to get the  bubbling effect of the dry ice"}]}