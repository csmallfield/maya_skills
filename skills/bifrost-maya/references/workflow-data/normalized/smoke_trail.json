a more turbulent trail.  Reducing the negative inherit will produce a straighter trail</span></p></body></html>"},{"type":"sticky_note","text":"<!DOCTYPE HTML PUBLIC \"-//W3C//DTD HTML 4.0//EN\" \"http://www.w3.org/TR/REC-html40/strict.dtd\">\n<html><head><meta name=\"qrichtext\" content=\"1\" /><style type=\"text/css\">\np, li { white-space: pre-wrap; }\n</style></head><body style=\" font-family:'Segoe UI'; font-size:12px; font-weight:400; font-style:normal;\">\n<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" font-size:12px;\">Increasing solver substeps smooths  out the trail when large negative inherit velocity is used</span></p></body></html>"},{"type":"sticky_note","text":"<!DOCTYPE HTML PUBLIC \"-//W3C//DTD HTML 4.0//EN\" \"http://www.w3.org/TR/REC-html40/strict.dtd\">\n<html><head><meta name=\"qrichtext\" content=\"1\" /><style type=\"text/css\">\np, li { white-space: pre-wrap; }\n</style></head><body style=\" font-family:'Segoe UI'; font-size:12px; font-weight:400; font-style:normal;\">\n<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" font-size:12px;\">Change the mode to enable  file cache</span></p></body></html>"}]},"ports":[{"portName":"out_geometry","portDirection":"output","portType":"Object"},{"portName":"mesh_out","portDirection":"output","portType":"Object"}],"terminal_states":[{"name":"Core::Graph::terminal::final","enabled":"false"},{"name":"Core::Graph::terminal::proxy","enabled":"false"},{"name":"Core::Graph::terminal::diagnostic","enabled":"false"}],"node_count":14,"connection_count":15,"value_count":67},{"path":"root/animated_sphere","name":"animated_sphere","metadata":{},"ports":[{"portName":"mesh_out","portDirection":"output","portType":"Object"}],"terminal_states":[],"node_count":6,"connection_count":8,"value_count":9}],"teaching_notes":[{"type":"sticky_note","text":"<!