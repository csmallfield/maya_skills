_count":18},{"path":"root/colored_plane_of_points","name":"colored_plane_of_points","metadata":{"_notes":[{"type":"sticky_note","text":"The incoming y_position is converted to a vector to use as the position of the plane.  This provides the animation."},{"type":"sticky_note","text":"This is the plane that will be providing our colored points"},{"type":"sticky_note","text":"The point information will provide both the position of our points and the color."},{"type":"sticky_note","text":"Because the position can be both positive and negative, we resample the array into a range of 0-1 in all channels to provide a color."}],"_backdrops":[{"type":"backdrop","title":"Motion"},{"type":"backdrop","title":"Dummy Geo"},{"type":"backdrop","title":"Get point Information"},{"type":"backdrop","title":"Points object for positions"},{"type":"backdrop","title":"Color Conversion"}]},"ports":[{"portName":"y_position","portDirection":"input"},{"portName":"points","portDirection":"output"},{"portName":"colors","portDirection":"output"},{"portName":"segments","portDirection":"input","portType":"int"}],"terminal_states":[],"node_count":6,"connection_count":12,"value_count":9}],"teaching_notes":[{"type":"sticky_note","text":"Here we create a plane of points then use their positions to generate colors"},{"type":"sticky_note","text":"The time node provides time and frame information."},{"type":"sticky_note","text":"This fCurve  provides the repeating motion of the points by having it's pre- and post-evaluation set to \"cycling\", causing an oscillating animation."},{"type":"sticky_note","text":"We use the colors generated in the previous compound as an emissive shader on the points, enabling us to render then as \"glowing\""},{"type":"sticky_note","text":"We use the colors generated by the ***sample_points_by_radius*** compound to color our ground plane.  These are the colors in a radius of the point object.  Try changing settings on the ***sample_points_by_radius*** compound to see different results."},{"type":"sticky_note","text":"The two objects, now colored, are output for display and rendering in Arnold."},{"type":"sticky_note","text":"Please feel free to replace with your own geo."},{"type":"sticky_note","text":"# ***sample_point_by_radius***\n\nFor every *position* input it will search within a *radius* for points in the `geometry` and return a *weighted average* of the property by the distance to the samples.\n\nFor example, if a position samples 4 points in a given radius then it will average the property at those 4 points based on the distance to those points.  "},{"type":"sticky_note","text":"The incoming y_position is converted to a vector to use as the position of the plane.  This provides the animation."},{"type":"sticky_note","text":"This is the plane that will be providing our colored points"},{"type":"sticky_note","text":"The point information will provide both the position of our points and the color."},{"type":"sticky_note","text":"Because the position can be both positive and negative, we resample the array into a range of 0-1 in all channels to provide a color."}]}