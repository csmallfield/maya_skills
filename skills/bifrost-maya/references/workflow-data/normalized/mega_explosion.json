"portType":"Object"}],"terminal_states":[{"name":"Core::Graph::terminal::final","enabled":"false"},{"name":"Core::Graph::terminal::proxy","enabled":"false"},{"name":"Core::Graph::terminal::diagnostic","enabled":"false"}],"node_count":31,"connection_count":37,"value_count":162},{"path":"root/assign_gray_shader","name":"assign_gray_shader","metadata":{},"ports":[{"portName":"geometry","portDirection":"input","portType":"Object"},{"portName":"out_geometry","portDirection":"output","portType":"Object"}],"terminal_states":[],"node_count":2,"connection_count":3,"value_count":39},{"path":"root/assign_gray_shader1","name":"assign_gray_shader1","metadata":{},"ports":[{"portName":"geometry","portDirection":"input","portType":"Object"},{"portName":"out_geometry","portDirection":"output","portType":"Object"}],"terminal_states":[],"node_count":2,"connection_count":3,"value_count":39}],"teaching_notes":[{"type":"sticky_note","text":"<!DOCTYPE HTML PUBLIC \"-//W3C//DTD HTML 4.0//EN\" \"http://www.w3.org/TR/REC-html40/strict.dtd\">\n<html><head><meta name=\"qrichtext\" content=\"1\" /><style type=\"text/css\">\np, li { white-space: pre-wrap; }\n</style></head><body style=\" font-family:'Segoe UI'; font-size:12px; font-weight:400; font-style:normal;\">\n<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" font-size:12px;\">The third combustion reaction.  Although source temperature is varied, the max is below the ignition temperature of the fuel.  This rection relies on the heat produced from the first and second reactions for ignition.  This creates a cascading effect.  </span></p></body></html>"}]}