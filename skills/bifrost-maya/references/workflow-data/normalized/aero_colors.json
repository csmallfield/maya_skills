,"text":"# Aero Simulation\nAll the data and settings are gathered and the simulation is performed."},{"type":"sticky_note","text":"# ***post_refine_aero***\n\nThe ***post_refine_aero*** compound will upres the Aero simulation.  You can get really good looking results with this method, but it will slow down the simulation"}],"_backdrops":[{"type":"backdrop","title":"Source Colour"},{"type":"backdrop","title":"Post Sim Process"},{"type":"backdrop","title":"Display Scope"},{"type":"backdrop","title":"Double-click for more info"},{"type":"backdrop","title":"Double-click for more info\n"},{"type":"backdrop","title":"Double-click for more info\n"},{"type":"backdrop","title":"Aero simulation"},{"type":"backdrop","title":"Assign material and output"},{"type":"backdrop","title":"Double-click for more info"},{"type":"backdrop","title":"Aero source"},{"type":"backdrop","title":"Post Refine Aero"}]},"ports":[],"terminal_states":[{"name":"Core::Graph::terminal::final","enabled":"true"},{"name":"Core::Graph::terminal::proxy","enabled":"true"},{"name":"Core::Graph::terminal::diagnostic","enabled":"false"}],"node_count":16,"connection_count":21,"value_count":58},{"path":"root/noisy_density","name":"noisy_density","metadata":{"_notes":[{"type":"sticky_note","text":"Creates a fractal_noise_field (scalar) and clamps the results to the 0-1 range"},{"type":"sticky_note","text":"This section creates a mesh torus, uses it as a bounding geometry for the generated field to a fog_density volume, as well as converting it to a fog_density volume."},{"type":"sticky_note","text":"The resulting volumes are then merged and output both as an output and a disgnostic display."}],"_backdrops":[{"type":"backdrop","title":"Construct curl noise"},{"type":"backdrop","title":"Backdrop 1"},{"type":"backdrop","title":"Merge and output"}]},"ports":[{"portName":"out_volume","portDirection":"output","portType":"Object"},{"portName":"time_field","portDirection":"input"}],"terminal_states":[],"node_count":9,"con