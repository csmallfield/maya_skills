/body></html>"}],"_backdrops":[{"type":"backdrop","title":"Particles are used as source geometry for the aero simulation.  This gives the sim a look more like mist."}]},"ports":[{"portName":"preview_geo","portDirection":"output","portType":"Object"},{"portName":"aero_volume","portDirection":"output","portType":"Object"}],"terminal_states":[{"name":"Core::Graph::terminal::final","enabled":"false"},{"name":"Core::Graph::terminal::proxy","enabled":"false"},{"name":"Core::Graph::terminal::diagnostic","enabled":"false"}],"node_count":18,"connection_count":19,"value_count":79},{"path":"root/assign_gray_shader","name":"assign_gray_shader","metadata":{},"ports":[{"portName":"geometry","portDirection":"input","portType":"Object"},{"portName":"out_geometry","portDirection":"output","portType":"Object"}],"terminal_states":[],"node_count":2,"connection_count":3,"value_count":39}],"teaching_notes":[{"type":"sticky_note","text":"<!DOCTYPE HTML PUBLIC \"-//W3C//DTD HTML 4.0//EN\" \"http://www.w3.org/TR/REC-html40/strict.dtd\">\n<html><head><meta name=\"qrichtext\" content=\"1\" /><style type=\"text/css\">\np, li { white-space: pre-wrap; }\n</style></head><body style=\" font-family:'Segoe UI'; font-size:12px; font-weight:400; font-style:normal;\">\n<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" font-size:12px;\">Vorticity is modulated with fog density, as usual.  Additionally, it's also modulated by the inverse of the velocity, so that details fade away as the flow slows down</span></p></body></html>"}]}