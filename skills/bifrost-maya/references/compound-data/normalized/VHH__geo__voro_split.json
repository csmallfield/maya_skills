ile_seed***</span>\n<br />Random seed for the point scattering.\n\n<span style=\"color:#E69963\">***scatter_mode***</span>\n<br />Random or Bluenoise scattering.\n\n***\n## Output\n<span style=\"color:#90A3F4\">***output_mesh_array***</span>\n<br />An array of meshes after the split.  Each tile is broken away from the original mesh and added to the output array.","ports":[{"name":"output_mesh_array","direction":"output","type":null},{"name":"incoming_mesh","direction":"input","type":"Object"},{"name":"input_points","direction":"input","type":"array<Math::float3>"},{"name":"triangulate_mesh","direction":"input","type":"bool","default":"true"},{"name":"number_of_tiles","direction":"input","type":"long","default":"61"},{"name":"tile_seed","direction":"input","type":"long","default":"312544825"},{"name":"scatter_mode","direction":"input","type":"Modeling::Points::ScatteringMode","default":"Random"}],"terminal_states":[{"name":"Core::Graph::terminal::diagnostic","enabled":"false"},{"name":"Core::Graph::terminal::final","enabled":"false"},{"name":"Core::Graph::terminal::proxy","enabled":"false"}],"counts":{"nodes":51,"connections":108,"values":51,"nested_compounds":7},"node_types":{"Core::Logic::if":6,"Core::Graph::pass":3,"Core::Array::get_from_array":3,"Core::Array::first_in_array":3,"Core::Array::array_is_empty":2,"Core::Graph::terminal":2,"Core::Math::subtract":2,"Diagnostic::Display::assign_diagnostic_material":2,"for_each1":1,"voronoise":1,"Geometry::Properties::get_geo_property":1,"Geometry::Mesh::points_to_faces":1,"Core::Array::sequence_array":1,"Geometry::Mesh::triangulate_mesh":1,"Geometry::Mesh::update_mesh_adjacency":1,"Core::Array::array_size":1,"Core::Array::empty_array":1,"Geometry::Points::construct_points":1,"Diagnostic::Display::point_scope":1,"compound":1,"Core::Array::find_all_in_array":1,"voro_simple":1,"Modeling::Points::scatter_points":1,"Geometry::Properties::get_point_position":1,"Core::Randomization::random_value_array":1,"Core::Math::multiply":