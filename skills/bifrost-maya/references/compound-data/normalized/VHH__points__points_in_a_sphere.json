=\"color:#A8D977\">***normals***</span>\n<br />Generated normals of the points.  The point outwards from the center.","ports":[{"name":"size","direction":"output","type":"long"},{"name":"positions","direction":"output","type":"array<Math::float3>"},{"name":"how_many_points","direction":"input","type":"long","default":"200"},{"name":"radius","direction":"input","type":"float","default":"10f"},{"name":"offset","direction":"input","type":"Math::float3","default":{"x":"0f","y":"0f","z":"0f"}},{"name":"seed","direction":"input","type":"long","default":"84512"},{"name":"interpolation","direction":"input","type":"int","default":"0L"},{"name":"exponent","direction":"input","type":"float","default":"2f"},{"name":"normals","direction":"output","type":"array<Math::float3>"}],"terminal_states":[],"counts":{"nodes":91,"connections":150,"values":28,"nested_compounds":11},"node_types":{"Core::Math::multiply":16,"Unknown":8,"Core::Math::add":6,"Core::Logic::if":5,"Core::Logic::equal":5,"Core::Math::subtract":4,"Core::Math::divide":4,"Core::Array::array_bounds_impl":4,"Core::Math::length":4,"Core::Constants::pi":3,"Core::Math::sin":3,"Core::Math::cos":3,"Core::Constants::one":3,"Core::Array::first_in_array":3,"Core::Randomization::random_value_array":3,"Core::Math::normalize":1,"calculate_points_in_sphere":1,"interpolations":1,"u":1,"v":1,"Core::Math::acos":1,"Core::Math::cube_root":1,"Core::Conversion::scalar_to_vector3":1,"randR":1,"Core::Type_Conversion::to_long":1,"Core::Graph::pass":1,"exp":1,"in":1,"out":1,"smooth":1,"combo_box":1,"Core::Math::power":1},"custom_dependencies":{},"nodes":[{"path":"root","name":"subtract","type":"Core::Math::subtract"},{"path":"root","name":"normalize","type":"Core::Math::normalize"},{"path":"root","name":"calculate_points_in_sphere","type":"calculate_points_in_sphere"},{"path":"root","name":"interpolations","type":"interpolations"},{"path":"root/calculate_points_in_sphere","name":"u","type":"u"},{"path":"root/calculate_points_in_sphere","name":"