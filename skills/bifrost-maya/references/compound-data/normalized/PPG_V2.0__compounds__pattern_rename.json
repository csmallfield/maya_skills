e pattern left at the start\n+ End: aligns the pattern at the END and fills the array towards the start.\n\n### Mirror at Center\nFirst fills the RIGHT/SECOND half of the resulting array (starting/ending at the center) and then mirrors it over to the LEFT.","ports":[{"name":"object","direction":"input","type":"Object"},{"name":"face_IDs_to_rename","direction":"input","type":null},{"name":"pattern","direction":"input","type":"string","default":"A,B,C,D"},{"name":"reverse_pattern","direction":"input","type":"bool","default":"false"},{"name":"pattern_repeat","direction":"input","type":"uint","default":"0U"},{"name":"pattern_align","direction":"input","type":"uint","default":"0U"},{"name":"mirror_at_center","direction":"input","type":"bool","default":"false"},{"name":"out_object","direction":"output","type":null},{"name":"inherit_source_tag","direction":"input","type":"bool","default":"true"}],"terminal_states":[{"name":"Core::Graph::terminal::proxy","enabled":"true"},{"name":"Core::Graph::terminal::diagnostic","enabled":"true"}],"counts":{"nodes":30,"connections":67,"values":19,"nested_compounds":7},"node_types":{"Core::Logic::if":4,"Core::Array::build_array":3,"iterate":2,"Core::Array::array_size":2,"PPG::set_face_tag":2,"Core::Array::get_from_array":2,"PPG::create_pattern":1,"Core::String::string_to_array":1,"Core::Array::reverse_array":1,"for_each":1,"create_pattern_sequence":1,"Core::String::string_join":1,"Core::Logic::equal":1,"get_tags_per_face":1,"Geometry::Properties::get_indexed_geo_property":1,"for_each1":1,"Core::Array::first_in_array":1,"Core::Logic::less":1,"Core::String::number_to_string":1,"Core::Array::sequence_array":1,"Core::String::build_string":1},"custom_dependencies":{"PPG::set_face_tag":2,"PPG::create_pattern":1},"nodes":[{"path":"root","name":"iterate","type":"iterate"},{"path":"root","name":"array_size","type":"Core::Array::array_size"},{"path":"root","name":"create_pattern2","type":"PPG::create_pattern"},{"path":"root","name":"string_to_array