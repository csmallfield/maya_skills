ormals that are 45 degrees from \"Vector\".\n- ***90*** = Looking for faces normals that are perpendicular (90 degrees) to \"Vector\".\n- ***180*** = Looking for faces normals that point in the opposite direction.\n\n### Tolerance Angle\nTolerance for \"Goal\" in Euler degrees.\n\n### Front and Back Sides\nReturns matches for +Goal and -Goal.\n\n### Invert Output\nInverts the output.\n\n## Output\n\n### Face Tag\n Assign this new face tags to the output faces.\n\n## Tutorial\nhttps://youtu.be/T8PXtWaS4GM\n<br><br>","ports":[{"name":"mesh","direction":"input","type":"Object"},{"name":"tag_expression","direction":"input","type":"string","default":"*"},{"name":"face_indices","direction":"input","type":null},{"name":"invert","direction":"input","type":"bool","default":"false"},{"name":"vector","direction":"input","type":null,"default":{"x":"0f","y":"1f","z":"0f"}},{"name":"tolerance_angle","direction":"input","type":null,"default":"25f"},{"name":"out_object","direction":"output","type":null},{"name":"indices","direction":"output","type":null},{"name":"goal_angle","direction":"input","type":null,"default":"0f"},{"name":"set_face_tag","direction":"input","type":"string","default":"selected_faces"},{"name":"front_and_back_sides","direction":"input","type":"bool","default":"false"},{"name":"invert_output","direction":"input","type":"bool","default":"false"},{"name":"inherit_source_tags","direction":"input","type":"bool","default":"false"}],"terminal_states":[{"name":"Core::Graph::terminal::final","enabled":"true"},{"name":"Core::Graph::terminal::proxy","enabled":"true"},{"name":"Core::Graph::terminal::diagnostic","enabled":"true"}],"counts":{"nodes":40,"connections":81,"values":7,"nested_compounds":4},"node_types":{"Core::Logic::if":5,"Core::Math::absolute_value":3,"Core::Array::get_from_array":3,"Core::Math::subtract":2,"PPG::set_face_tag":2,"Unknown":2,"Core::Math::cos":2,"Core::Conversion::degrees_to_radians":2,"Geometry::Mesh::update_face_normals":1,"Core::Math::dot":1,